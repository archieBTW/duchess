# ==============================================================================
# bybl Backend Environment Variables (Deployed by Ansible from Vault/Secrets)
# Mode: 0600 (Strictly protected)
# ==============================================================================

# Database Settings
DB_DRIVER=postgres
DB_HOST=db
DB_PORT=5432
DB_USER={{ vault_postgres_user | default('bybl_user') }}
DB_PASSWORD={{ vault_postgres_password }}
DB_NAME={{ vault_postgres_db | default('bybl_db') }}

# PostgreSQL Initialization
POSTGRES_USER={{ vault_postgres_user | default('bybl_user') }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ vault_postgres_db | default('bybl_db') }}

# Application Server
PORT=8080
ADMIN_PORT=8081
GIN_MODE=release

# Authentication & Admin Security
JWT_SECRET={{ vault_jwt_secret }}
ADMIN_BASE_PATH=/admin
ADMIN_TITLE=bybl Admin
ADMIN_DEFAULT_DISK=local
ADMIN_EMAIL={{ vault_admin_email | default('arch@archerwoods.dev') }}
ADMIN_PASSWORD={{ vault_admin_password | default('admin123') }}

# External APIs
BIBLE_KEY={{ vault_bible_key | default('') }}
ESV_KEY={{ vault_esv_key | default('') }}
RESEND_API_KEY={{ vault_resend_api_key | default('') }}
EMAIL_ADDRESS={{ vault_email_address | default('noreply@bybl.dev') }}

# Wasabi / S3 Storage (Optional)
WASABI_REGION={{ vault_wasabi_region | default('us-east-1') }}
WASABI_ENDPOINT={{ vault_wasabi_endpoint | default('') }}
WASABI_ACCESS_KEY={{ vault_wasabi_access_key | default('') }}
WASABI_SECRET_KEY={{ vault_wasabi_secret_key | default('') }}
WASABI_BUCKET={{ vault_wasabi_bucket | default('') }}
